{
  "manifest_version": 3,
  "name": "ImgScout",
  "version": "1.0.0",
  "description": "Fast image discovery and extraction from any website.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "ImgScout",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  }
}